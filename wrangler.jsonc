{
  "name": "moreiragabryel",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-07-01",
  "upload_source_maps": false,
  "send_metrics": false,
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "VISITOR_COUNTER_DB",
      "database_id": "b27ceda2-3600-4f52-80d4-e5c311332f03"
    }
  ]
}
